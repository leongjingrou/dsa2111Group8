  "rules": [
    {
      "id": "RF_CHEST_PAIN",
      "disposition": "emergency",
      "any_of": [
        "chest_pain"
      ],
      "reason": "Chest pain requires emergency assessment.",
      "source_ids": [
        "sg_moh_emergencies"
      ]
    },
    {
      "id": "RF_BREATHING",
      "disposition": "emergency",
      "any_of": [
        "shortness_of_breath"
      ],
      "reason": "Breathing difficulty requires emergency assessment.",
      "source_ids": [
        "sg_moh_emergencies",
        "sg_scdf_ems"
      ]
    },
    {
      "id": "RF_ALTERED_CONSCIOUSNESS",
      "disposition": "emergency",
      "any_of": [
        "confusion_drowsiness",
        "loss_of_consciousness",
        "seizure"
      ],
      "reason": "Altered consciousness or a seizure needs emergency assessment; the bundled confusion/drowsiness field is handled conservatively.",
      "source_ids": [
        "sg_moh_emergencies",
        "sg_scdf_ems"
      ]
    },
    {
      "id": "RF_MAJOR_BLEEDING",
      "disposition": "emergency",
      "any_of": [
        "uncontrolled_bleeding",
        "vomiting_blood",
        "black_stools"
      ],
      "reason": "Uncontrolled bleeding or possible significant gastrointestinal bleeding needs emergency assessment.",
      "source_ids": [
        "sg_moh_emergencies",
        "sg_skh_emergency",
        "sg_cda_dengue"
      ]
    },
    {
      "id": "RF_SEVERE_ABDOMINAL_PAIN",
      "disposition": "emergency",
      "any_of": [
        "severe_abdominal_pain"
      ],
      "reason": "Severe abdominal pain needs emergency assessment regardless of the model's diagnosis.",
      "source_ids": [
        "sg_moh_emergencies"
      ]
    },
    {
      "id": "RF_SUDDEN_HEADACHE",
      "disposition": "emergency",
      "any_of": [
        "sudden_severe_headache"
      ],
      "reason": "A sudden worst-ever headache must not follow the routine migraine pathway.",
      "source_ids": [
        "sg_healthhub_headache",
        "nhs_headaches"
      ]
    },
    {
      "id": "RF_STROKE_SIGNS",
      "disposition": "emergency",
      "any_of": [
        "facial_droop",
        "speech_difficulty",
        "sudden_one_sided_weakness"
      ],
      "reason": "Possible acute stroke signs need emergency assessment.",
      "source_ids": [
        "sg_skh_emergency",
        "sg_scdf_ems"
      ]
    },
    {
      "id": "RF_AIRWAY",
      "disposition": "emergency",
      "any_of": [
        "swollen_tongue_or_throat",
        "difficulty_opening_mouth"
      ],
      "reason": "Tongue/throat swelling or the vocabulary's bundled mouth-opening/drooling symptom may indicate an airway threat; assess urgently in emergency care.",
      "source_ids": [
        "sg_nhg_anaphylaxis",
        "nhs_tonsillitis"
      ]
    },
    {
      "id": "RF_HEADACHE_NECK",
      "disposition": "emergency",
      "all_of": [
        "headache",
        "neck_stiffness"
      ],
      "reason": "Headache with neck stiffness requires emergency assessment rather than a routine headache label.",
      "source_ids": [
        "nhs_headaches",
        "sg_healthhub_headache"
      ]
    },
    {
      "id": "RF_HEADACHE_NEURO",
      "disposition": "emergency",
      "all_of": [
        "headache",
        "weakness_numbness"
      ],
      "reason": "Headache accompanied by weakness or numbness needs emergency assessment.",
      "source_ids": [
        "nhs_headaches"
      ]
    },
    {
      "id": "RF_EYE_VISION",
      "disposition": "emergency",
      "all_of": [
        "red_eyes",
        "blurred_vision"
      ],
      "reason": "A red eye with affected vision needs emergency assessment.",
      "source_ids": [
        "sg_moh_eyes"
      ]
    },
    {
      "id": "RF_DENGUE_WARNING",
      "disposition": "emergency",
      "all_of": [
        "fever",
        "bleeding_gums_nose"
      ],
      "reason": "Fever with mucosal bleeding may indicate a dangerous infection, including dengue, and needs immediate assessment.",
      "source_ids": [
        "sg_cda_dengue"
      ]
    },
    {
      "id": "RF_PERSISTENT_VOMITING",
      "disposition": "urgent_review",
      "any_of": [
        "persistent_vomiting"
      ],
      "reason": "Persistent vomiting needs prompt assessment; the field does not distinguish continuous vomiting or ability to retain fluids.",
      "source_ids": [
        "sg_cda_gastro",
        "sg_moh_emergencies"
      ]
    },
    {
      "id": "RF_DEHYDRATION",
      "disposition": "urgent_review",
      "any_of": [
        "dehydration_signs"
      ],
      "reason": "Reported dehydration requires prompt assessment; the bundled field does not establish severity.",
      "source_ids": [
        "sg_cda_gastro"
      ]
    },
    {
      "id": "RF_BLOOD_STOOL",
      "disposition": "urgent_review",
      "any_of": [
        "blood_in_stool"
      ],
      "reason": "Blood in the stool needs prompt clinical assessment.",
      "source_ids": [
        "sg_cda_gastro"
      ]
    },
    {
      "id": "RF_MUCOSAL_BLEEDING",
      "disposition": "urgent_review",
      "any_of": [
        "bleeding_gums_nose"
      ],
      "reason": "Reported gum/nose bleeding needs assessment; associated fever activates the emergency dengue-warning rule.",
      "source_ids": [
        "sg_cda_dengue"
      ]
    },
    {
      "id": "RF_WHEEZING",
      "disposition": "urgent_review",
      "any_of": [
        "wheezing"
      ],
      "reason": "Wheezing requires prompt assessment; associated breathing difficulty or airway swelling activates emergency rules.",
      "source_ids": [
        "sg_nhg_anaphylaxis",
        "sg_healthhub_selfmedication"
      ]
    },
    {
      "id": "RF_NEUROLOGICAL",
      "disposition": "urgent_review",
      "any_of": [
        "weakness_numbness",
        "neck_stiffness"
      ],
      "reason": "Neurological complaints need prompt assessment; sudden focal findings and associated headache have separate emergency rules.",
      "source_ids": [
        "sg_healthhub_headache",
        "sg_moh_emergencies"
      ]
    },
    {
      "id": "RF_EYE_REVIEW",
      "disposition": "urgent_review",
      "any_of": [
        "eye_pain",
        "blurred_vision",
        "periorbital_swelling"
      ],
      "reason": "Eye pain, affected vision or swelling needs direct clinical assessment; red eye with blurred vision activates an emergency rule.",
      "source_ids": [
        "sg_moh_eyes",
        "sg_healthhub_selfmedication"
      ]
    },
    {
      "id": "RF_FLANK_PAIN",
      "disposition": "urgent_review",
      "any_of": [
        "flank_pain"
      ],
      "reason": "Flank/back pain can require assessment for kidney involvement rather than a routine lower-UTI pathway.",
      "source_ids": [
        "nhs_uti"
      ]
    },
    {
      "id": "RF_SKIN_INFECTION",
      "disposition": "urgent_review",
      "any_of": [
        "skin_infection_signs"
      ],
      "reason": "Possible skin infection needs clinical assessment rather than routine self-treatment.",
      "source_ids": [
        "sg_healthhub_selfmedication"
      ]
    },
    {
      "id": "RF_WEIGHT_LOSS",
      "disposition": "clinician_review",
      "any_of": [
        "unintentional_weight_loss"
      ],
      "reason": "Unexplained weight loss needs clinician review outside the routine minor-illness pathway.",
      "source_ids": [
        "nhs_weight_loss"
      ]
    }
  ]
}
