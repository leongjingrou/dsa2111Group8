{
  "description": "Fictional, hand-authored software acceptance cases, not clinician-validated triage labels. Unless use_baseline is false, each patient explicitly denies every baseline screening finding, reports a runny nose, is aged 30, and explicitly reports not being pregnant. Case updates replace those answers. Missing findings never inherit negatives outside this declared test baseline.",
  "baseline_profile": {
    "age": 30,
    "pregnancy_status": false,
    "symptoms": {
      "runny_nose": true,
      "shortness_of_breath": false, "chest_pain": false,
      "confusion_drowsiness": false, "vomiting_blood": false,
      "black_stools": false, "severe_abdominal_pain": false,
      "sudden_severe_headache": false, "difficulty_opening_mouth": false,
      "persistent_vomiting": false, "dehydration_signs": false,
      "blood_in_stool": false, "bleeding_gums_nose": false,
      "wheezing": false, "weakness_numbness": false, "neck_stiffness": false,
      "eye_pain": false, "blurred_vision": false, "periorbital_swelling": false,
      "flank_pain": false, "skin_infection_signs": false,
      "unintentional_weight_loss": false, "loss_of_consciousness": false,
      "uncontrolled_bleeding": false, "facial_droop": false,
      "speech_difficulty": false, "sudden_one_sided_weakness": false,
      "swollen_tongue_or_throat": false, "seizure": false
    }
  },
  "cases": [
    {"id":"V001", "vignette":"Adult with mild runny nose and an explicitly negative complete screen.", "expected":"continue_assessment", "rules":[]},
    {"id":"V002", "vignette":"Patient is exactly 18 years old.", "profile":{"age":18}, "expected":"continue_assessment", "rules":[]},
    {"id":"V003", "vignette":"Patient is 64 years old.", "profile":{"age":64}, "expected":"continue_assessment", "rules":[]},
    {"id":"V004", "vignette":"Patient is 17 years old, outside configured adult scope.", "profile":{"age":17}, "expected":"clinician_review", "rules":["SCOPE_AGE"]},
    {"id":"V005", "vignette":"Patient is exactly 65, outside the configured upper boundary.", "profile":{"age":65}, "expected":"clinician_review", "rules":["SCOPE_AGE"]},
    {"id":"V006", "vignette":"Pregnant adult with otherwise minor symptoms.", "profile":{"pregnancy_status":true}, "expected":"clinician_review", "rules":["SCOPE_PREGNANCY"]},
    {"id":"V007", "vignette":"Adult does not know their pregnancy status.", "profile":{"pregnancy_status":"unknown"}, "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V008", "vignette":"Age has not been collected.", "remove":["age"], "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V009", "vignette":"Chest pain is reported before age or any screening negatives are collected.", "use_baseline":false, "profile":{"symptoms":{"chest_pain":true}}, "expected":"emergency", "rules":["RF_CHEST_PAIN","SCREEN_INCOMPLETE"]},
    {"id":"V010", "vignette":"Adult reports chest pain despite an otherwise negative screen.", "profile":{"symptoms":{"chest_pain":true}}, "expected":"emergency", "rules":["RF_CHEST_PAIN"]},
    {"id":"V011", "vignette":"Adult reports breathing difficulty.", "profile":{"symptoms":{"shortness_of_breath":true}}, "expected":"emergency", "rules":["RF_BREATHING"]},
    {"id":"V012", "vignette":"Unusual confusion or drowsiness is reported.", "profile":{"symptoms":{"confusion_drowsiness":true}}, "expected":"emergency", "rules":["RF_ALTERED_CONSCIOUSNESS"]},
    {"id":"V013", "vignette":"Patient has vomited blood.", "profile":{"symptoms":{"vomiting_blood":true}}, "expected":"emergency", "rules":["RF_MAJOR_BLEEDING"]},
    {"id":"V014", "vignette":"Patient reports black tarry stools.", "profile":{"symptoms":{"black_stools":true}}, "expected":"emergency", "rules":["RF_MAJOR_BLEEDING"]},
    {"id":"V015", "vignette":"Patient reports severe abdominal pain.", "profile":{"symptoms":{"severe_abdominal_pain":true}}, "expected":"emergency", "rules":["RF_SEVERE_ABDOMINAL_PAIN"]},
    {"id":"V016", "vignette":"Patient describes a sudden worst-ever headache.", "profile":{"symptoms":{"sudden_severe_headache":true}}, "expected":"emergency", "rules":["RF_SUDDEN_HEADACHE"]},
    {"id":"V017", "vignette":"Patient reports the bundled mouth-opening difficulty or drooling finding.", "profile":{"symptoms":{"difficulty_opening_mouth":true}}, "expected":"emergency", "rules":["RF_AIRWAY"]},
    {"id":"V018", "vignette":"Loss of consciousness has been reported.", "profile":{"symptoms":{"loss_of_consciousness":true}}, "expected":"emergency", "rules":["RF_ALTERED_CONSCIOUSNESS"]},
    {"id":"V019", "vignette":"Patient reports uncontrolled bleeding.", "profile":{"symptoms":{"uncontrolled_bleeding":true}}, "expected":"emergency", "rules":["RF_MAJOR_BLEEDING"]},
    {"id":"V020", "vignette":"A seizure is reported.", "profile":{"symptoms":{"seizure":true}}, "expected":"emergency", "rules":["RF_ALTERED_CONSCIOUSNESS"]},
    {"id":"V021", "vignette":"A new facial droop is reported.", "profile":{"symptoms":{"facial_droop":true}}, "expected":"emergency", "rules":["RF_STROKE_SIGNS"]},
    {"id":"V022", "vignette":"New speech difficulty is reported.", "profile":{"symptoms":{"speech_difficulty":true}}, "expected":"emergency", "rules":["RF_STROKE_SIGNS"]},
    {"id":"V023", "vignette":"Sudden weakness on one side is reported.", "profile":{"symptoms":{"sudden_one_sided_weakness":true}}, "expected":"emergency", "rules":["RF_STROKE_SIGNS"]},
    {"id":"V024", "vignette":"Headache occurs with neck stiffness.", "profile":{"symptoms":{"headache":true,"neck_stiffness":true}}, "expected":"emergency", "rules":["RF_HEADACHE_NECK","RF_NEUROLOGICAL"]},
    {"id":"V025", "vignette":"Headache occurs with weakness or numbness.", "profile":{"symptoms":{"headache":true,"weakness_numbness":true}}, "expected":"emergency", "rules":["RF_HEADACHE_NEURO","RF_NEUROLOGICAL"]},
    {"id":"V026", "vignette":"A red eye occurs with blurred vision.", "profile":{"symptoms":{"red_eyes":true,"blurred_vision":true}}, "expected":"emergency", "rules":["RF_EYE_VISION","RF_EYE_REVIEW"]},
    {"id":"V027", "vignette":"Fever occurs with bleeding gums or nose; a benign model label must not reassure.", "profile":{"symptoms":{"fever":true,"bleeding_gums_nose":true}}, "expected":"emergency", "rules":["RF_DENGUE_WARNING","RF_MUCOSAL_BLEEDING"]},
    {"id":"V028", "vignette":"Patient reports persistent vomiting.", "profile":{"symptoms":{"persistent_vomiting":true}}, "expected":"urgent_review", "rules":["RF_PERSISTENT_VOMITING"]},
    {"id":"V029", "vignette":"Patient reports the vocabulary's bundled dehydration signs.", "profile":{"symptoms":{"dehydration_signs":true}}, "expected":"urgent_review", "rules":["RF_DEHYDRATION"]},
    {"id":"V030", "vignette":"Patient reports blood in stool, with no major-bleeding finding.", "profile":{"symptoms":{"blood_in_stool":true}}, "expected":"urgent_review", "rules":["RF_BLOOD_STOOL"]},
    {"id":"V031", "vignette":"Gum or nose bleeding is reported without fever or uncontrolled bleeding.", "profile":{"symptoms":{"bleeding_gums_nose":true}}, "expected":"urgent_review", "rules":["RF_MUCOSAL_BLEEDING"]},
    {"id":"V032", "vignette":"Wheezing is reported without breathlessness or throat swelling.", "profile":{"symptoms":{"wheezing":true}}, "expected":"urgent_review", "rules":["RF_WHEEZING"]},
    {"id":"V033", "vignette":"Weakness or numbness has not been described as sudden or focal.", "profile":{"symptoms":{"weakness_numbness":true}}, "expected":"urgent_review", "rules":["RF_NEUROLOGICAL"]},
    {"id":"V034", "vignette":"Neck stiffness is reported without headache.", "profile":{"symptoms":{"neck_stiffness":true}}, "expected":"urgent_review", "rules":["RF_NEUROLOGICAL"]},
    {"id":"V035", "vignette":"Eye pain is reported.", "profile":{"symptoms":{"eye_pain":true}}, "expected":"urgent_review", "rules":["RF_EYE_REVIEW"]},
    {"id":"V036", "vignette":"Blurred vision is reported without the red-eye combination.", "profile":{"symptoms":{"blurred_vision":true}}, "expected":"urgent_review", "rules":["RF_EYE_REVIEW"]},
    {"id":"V037", "vignette":"Swelling around the eye is reported.", "profile":{"symptoms":{"periorbital_swelling":true}}, "expected":"urgent_review", "rules":["RF_EYE_REVIEW"]},
    {"id":"V038", "vignette":"Flank pain occurs with painful urination.", "profile":{"symptoms":{"flank_pain":true,"painful_urination":true}}, "expected":"urgent_review", "rules":["RF_FLANK_PAIN"]},
    {"id":"V039", "vignette":"Weeping or purulent skin changes are reported.", "profile":{"symptoms":{"skin_infection_signs":true}}, "expected":"urgent_review", "rules":["RF_SKIN_INFECTION"]},
    {"id":"V040", "vignette":"Patient reports unexplained weight loss.", "profile":{"symptoms":{"unintentional_weight_loss":true}}, "expected":"clinician_review", "rules":["RF_WEIGHT_LOSS"]},
    {"id":"V041", "vignette":"Model proposes dengue, which is outside the six-condition knowledge base.", "kwargs":{"candidate_condition":"dengue_fever"}, "expected":"clinician_review", "rules":["SCOPE_CONDITION"]},
    {"id":"V042", "vignette":"Model returns an unrecognised diagnosis label.", "kwargs":{"candidate_condition":"unknown_label"}, "expected":"clinician_review", "rules":["SCOPE_CONDITION"]},
    {"id":"V043", "vignette":"Model proposes the recognised human-readable Common Cold label.", "kwargs":{"candidate_condition":"Common Cold"}, "expected":"continue_assessment", "rules":[]},
    {"id":"V044", "vignette":"Patient first reported a cough, then denied it; conflict needs clarification.", "profile":{"contradictions":[{"symptom_id":"cough","previous":"present","new":"absent"}]}, "expected":"needs_clarification", "rules":["DATA_CONTRADICTION"]},
    {"id":"V045", "vignette":"Earlier chest pain is later denied; positive history must remain active.", "profile":{"contradictions":[{"symptom_id":"chest_pain","previous":"present","new":"absent"}]}, "expected":"emergency", "rules":["RF_CHEST_PAIN","DATA_CONTRADICTION"]},
    {"id":"V046", "vignette":"Patient is unsure whether chest pain is present.", "profile":{"symptoms":{"chest_pain":"uncertain"}}, "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V047", "vignette":"Extractor returns an unmapped symptom mention.", "profile":{"unmapped_mentions":["a new unexplained symptom"]}, "expected":"clinician_review", "rules":["SCOPE_UNMAPPED"]},
    {"id":"V048", "vignette":"Unknown symptom ID is supplied, rather than being ignored.", "profile":{"symptoms":{"not_in_vocabulary":true}}, "expected":"clinician_review", "rules":["SCOPE_UNMAPPED"]},
    {"id":"V049", "vignette":"Age is mistakenly a numeric string.", "profile":{"age":"30"}, "expected":"needs_clarification", "rules":["INPUT_INVALID","SCREEN_INCOMPLETE"]},
    {"id":"V050", "vignette":"Age is mistakenly a boolean.", "profile":{"age":true}, "expected":"needs_clarification", "rules":["INPUT_INVALID","SCREEN_INCOMPLETE"]},
    {"id":"V051", "vignette":"Pregnancy is supplied as the ambiguous string false instead of a boolean.", "profile":{"pregnancy_status":"false"}, "expected":"needs_clarification", "rules":["INPUT_INVALID","SCREEN_INCOMPLETE"]},
    {"id":"V052", "vignette":"Chest-pain presence is the invalid string false; it cannot become a negative.", "profile":{"symptoms":{"chest_pain":"false"}}, "expected":"needs_clarification", "rules":["INPUT_INVALID","SCREEN_INCOMPLETE"]},
    {"id":"V053", "vignette":"Chest pain has not been asked about.", "remove":["symptoms.chest_pain"], "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V054", "vignette":"No presenting symptom is supplied, despite a complete negative checklist.", "remove":["symptoms.runny_nose"], "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V055", "vignette":"Child is pregnant and reports both chest pain and wheezing; emergency priority wins.", "profile":{"age":17,"pregnancy_status":true,"symptoms":{"chest_pain":true,"wheezing":true}}, "expected":"emergency", "rules":["RF_CHEST_PAIN","RF_WHEEZING","SCOPE_AGE","SCOPE_PREGNANCY"]},
    {"id":"V056", "vignette":"Model's urgent recommendation is retained even with an unanswered chest-pain screen.", "remove":["symptoms.chest_pain"], "kwargs":{"proposed_action":"urgent_medical_review","phase":"post_model","candidate_condition":"influenza"}, "expected":"urgent_review", "rules":["SCREEN_INCOMPLETE","MODEL_URGENT"]},
    {"id":"V057", "vignette":"Symptoms are malformed as a list.", "profile":{"symptoms":[]}, "expected":"needs_clarification", "rules":["INPUT_INVALID","SCREEN_INCOMPLETE"]},
    {"id":"V058", "vignette":"Contradictions are malformed as a dictionary.", "profile":{"contradictions":{}}, "expected":"needs_clarification", "rules":["INPUT_INVALID"]},
    {"id":"V059", "vignette":"Patient explicitly confirms pregnancy is not applicable; no inference from sex is used.", "profile":{"pregnancy_status":"not_applicable"}, "expected":"continue_assessment", "rules":[]},
    {"id":"V060", "vignette":"Pregnancy fields disagree; positive pregnancy excludes routine care.", "profile":{"pregnant":true}, "expected":"clinician_review", "rules":["SCOPE_PREGNANCY","DATA_CONTRADICTION"]},
    {"id":"V061", "vignette":"EvidenceState and Profile ages conflict, including an out-of-scope age.", "kwargs":{"evidence":{"age":80}}, "expected":"clinician_review", "rules":["SCOPE_AGE","DATA_CONTRADICTION"]},
    {"id":"V062", "vignette":"A swollen tongue or throat is reported.", "profile":{"symptoms":{"swollen_tongue_or_throat":true}}, "expected":"emergency", "rules":["RF_AIRWAY"]},
    {"id":"V063", "vignette":"Post-model output omits its proposed condition.", "kwargs":{"phase":"post_model","proposed_action":"routine_teleconsultation"}, "expected":"needs_clarification", "rules":["SCREEN_INCOMPLETE"]},
    {"id":"V064", "vignette":"Model proposes an unsupported action value.", "kwargs":{"phase":"post_model","candidate_condition":"common_cold","proposed_action":"ignore_the_patient"}, "expected":"needs_clarification", "rules":["MODEL_ACTION_INVALID"]}
  ]
}
